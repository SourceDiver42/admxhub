{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADMX Hub source definition (src/admxhub/sources/<id>.yaml)",
  "type": "object",
  "required": ["id", "name", "vendor", "description", "homepage", "license", "markers", "discovery"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
    "name": {"type": "string"},
    "vendor": {"type": "string"},
    "description": {"type": "string"},
    "homepage": {"type": "string", "format": "uri"},
    "license": {"type": "string", "description": "License of the template files; 'proprietary' forbids mirroring"},
    "mirror": {"type": "boolean", "default": false, "description": "Host copies of the files (only for licenses that allow redistribution)"},
    "markers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\.admx$"},
                "description": "ADMX file names whose presence means the product is installed"},
    "discovery": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {"enum": ["static", "redirect", "json", "html"]},
        "url": {"type": "string", "pattern": "^https://"},
        "browser": {"type": "boolean", "description": "Send a browser User-Agent"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"},
                    "description": "Extra headers; ${VAR} comes from the environment, headers with unset variables are skipped"},
        "version": {"type": "string", "description": "Regex for the version (group 1) in a file name / value"},
        "items": {"type": "string", "description": "json: JMESPath giving the list to pick from (context: root)"},
        "filter": {"type": "object", "properties": {"field": {"type": "string"}, "regex": {"type": "string"}}},
        "order_by": {"type": "string", "description": "json: JMESPath on item; highest version wins"},
        "fields": {"type": "object", "required": ["version", "url"],
                   "properties": {"version": {"type": "string"}, "url": {"type": "string"}, "date": {"type": "string"},
                                  "size": {"type": "string"}, "sha256": {"type": "string"}},
                   "description": "json: JMESPath expressions over {root, item}"},
        "links": {"type": "string", "description": "html: regex for candidate links"},
        "match": {"type": "string", "description": "html: regex the wanted link must match"}
      }
    },
    "version_from": {"type": "object", "required": ["file", "pattern"],
                     "properties": {"file": {"type": "string"}, "pattern": {"type": "string"}, "join": {"type": "string"}},
                     "description": "Read the real version from a file inside the download"},
    "archive": {"type": "object",
                "properties": {"include": {"type": "array", "items": {"type": "string"}, "description": "Regexes for template paths to keep"},
                               "exe_args": {"type": "array", "items": {"type": "string"}, "description": "How a self-extracting .exe unpacks itself on Windows; {dest} = target folder"}}}
  }
}
